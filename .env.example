# Copy to .env.local. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only
DATABASE_URL=                       # server-only
OWNER_USER_ID=                      # uuid of your single Supabase Auth user

# App
APP_BASE_URL=https://your-domain.example
CRON_SECRET=                        # random long string; required by /api/cron/*
ENCRYPTION_KEY=                     # 32-byte base64; encrypts stored OAuth tokens

# LLM (interchangeable)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# Google Sheets (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/google/callback

# Optional notifications
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
